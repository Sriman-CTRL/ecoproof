// EcoProof prototype schema. Table/field names follow docs/text/07-tech-stack.txt "Data model".
// Prisma bypasses Supabase RLS: the API must filter by org_id on every query.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum QualityTag {
  measured
  owner_entered
  estimated
  default
}

enum FactorStatus {
  confirmed
  confirmed_replace
  verify
  estimate_only
  rule
}

enum GasBasis {
  CO2
  CO2e
}

enum Enduse {
  electricity
  fuel
}

enum OrgType {
  msme
  household
}

enum MembershipRole {
  owner
  accountant
  supervisor
}

enum DocumentKind {
  power_bill
  fuel
  invoice
  quote
}

enum DocumentSource {
  web
  whatsapp
}

enum SavingsStatus {
  early
  verified
}

// ---------------------------------------------------------------- business tables

model Organisation {
  id                String    @id @default(uuid()) @db.Uuid
  type              OrgType
  name              String
  udyamNo           String?   @map("udyam_no")
  gstin             String?
  sector            String?
  state             String?
  /// ADDITION: not in Doc 07, needed by FIN-1 scheme matcher (owner-entered business profile)
  udyamCategory     String?   @map("udyam_category")
  /// ADDITION: not in Doc 07, needed by FIN-1 (SIDBI 4E: 3+ years of operations) and the loan pack cover
  yearsInOperation  Int?      @map("years_in_operation")
  /// ADDITION: not in Doc 07, needed by FIN-1 (business profile: GST status)
  gstRegistered     Boolean?  @map("gst_registered")
  /// ADDITION: not in Doc 07, needed by FIN-1 (SIDBI 4E: cash profits)
  cashProfitsLast2y Boolean?  @map("cash_profits_last_2y")
  /// ADDITION: not in Doc 07, needed by FIN-1 (Telangana MSME Policy 2024: units commencing 18 Sep 2024 - 31 Mar 2029)
  commencedOn       DateTime? @map("commenced_on") @db.Date
  /// DEPRECATED (D7, 13 Oct 2026): replaced by women_owned + sc_st_owned; unused; drop after the pitch (additive-only migrations tonight)
  womenScStOwned    Boolean?  @map("women_sc_st_owned")
  /// ADDITION: not in Doc 07, needed by ZED (100% subsidy for women-owned MSMEs, PIB 4 Aug 2026)
  womenOwned        Boolean?  @map("women_owned")
  /// ADDITION: not in Doc 07, needed by ZED (+10% subsidy for SC/ST owned units)
  scStOwned         Boolean?  @map("sc_st_owned")
  createdAt         DateTime  @default(now()) @map("created_at")

  sites                 Site[]
  memberships           Membership[]
  consents              Consent[]
  documents             Document[]
  extractions           Extraction[]
  energyMonths          EnergyMonth[]
  fuelEntries           FuelEntry[]
  productionMonths      ProductionMonth[]
  results               Result[]
  baselines             Baseline[]
  siteActions           SiteAction[]
  savingsLedger         SavingsLedger[]
  reportSnapshots       ReportSnapshot[]
  reports               Report[]
  shares                Share[]
  shareViews            ShareView[]
  auditLog              AuditLog[]
  nonRoutineAdjustments NonRoutineAdjustment[]
  siteEquipment         SiteEquipment[]
  mitraSteps            MitraStep[]

  @@map("organisations")
}

model Site {
  id                  String   @id @default(uuid()) @db.Uuid
  orgId               String   @map("org_id") @db.Uuid
  address             String?
  lat                 Decimal? @db.Decimal(9, 6)
  lng                 Decimal? @db.Decimal(9, 6)
  discom              String?
  consumerNo          String?  @map("consumer_no")
  tariffCategory      String?  @map("tariff_category")
  contractedDemandKva Decimal? @map("contracted_demand_kva") @db.Decimal(10, 2)
  /// ADDITION: not in Doc 07, needed by Doc 03 validation rule (kWh <= sanctioned load x hours)
  sanctionedLoadKw    Decimal? @map("sanctioned_load_kw") @db.Decimal(10, 2)
  /// ADDITION: not in Doc 07, needed by Doc 03 rooftop solar size (A = usable roof area, owner-entered)
  roofAreaM2          Decimal? @map("roof_area_m2") @db.Decimal(10, 2)
  createdAt           DateTime @default(now()) @map("created_at")

  org                   Organisation           @relation(fields: [orgId], references: [id])
  documents             Document[]
  energyMonths          EnergyMonth[]
  fuelEntries           FuelEntry[]
  productionMonths      ProductionMonth[]
  results               Result[]
  baselines             Baseline[]
  siteActions           SiteAction[]
  savingsLedger         SavingsLedger[]
  nonRoutineAdjustments NonRoutineAdjustment[]
  siteEquipment         SiteEquipment[]
  reportSnapshots       ReportSnapshot[]
  mitraSteps            MitraStep[]

  @@index([orgId])
  @@map("sites")
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  phone     String   @unique
  language  String   @default("en")
  createdAt DateTime @default(now()) @map("created_at")

  memberships    Membership[]           @relation("MembershipUser")
  invitations    Membership[]           @relation("MembershipInvitedBy")
  consents       Consent[]
  nonRoutineLogs NonRoutineAdjustment[]

  @@map("users")
}

model Membership {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  orgId     String         @map("org_id") @db.Uuid
  role      MembershipRole
  invitedBy String?        @map("invited_by") @db.Uuid
  createdAt DateTime       @default(now()) @map("created_at")

  user    User         @relation("MembershipUser", fields: [userId], references: [id])
  inviter User?        @relation("MembershipInvitedBy", fields: [invitedBy], references: [id])
  org     Organisation @relation(fields: [orgId], references: [id])

  @@unique([userId, orgId])
  @@index([orgId])
  @@map("memberships")
}

model Consent {
  id            String    @id @default(uuid()) @db.Uuid
  orgId         String    @map("org_id") @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  noticeVersion String    @map("notice_version")
  purpose       String
  grantedAt     DateTime  @map("granted_at")
  withdrawnAt   DateTime? @map("withdrawn_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  org  Organisation @relation(fields: [orgId], references: [id])
  user User         @relation(fields: [userId], references: [id])

  @@index([orgId])
  @@map("consents")
}

model Document {
  id        String         @id @default(uuid()) @db.Uuid
  orgId     String         @map("org_id") @db.Uuid
  siteId    String         @map("site_id") @db.Uuid
  kind      DocumentKind
  fileKey   String         @map("file_key")
  sha256    String
  source    DocumentSource
  status    String         @default("received")
  createdAt DateTime       @default(now()) @map("created_at")

  org         Organisation @relation(fields: [orgId], references: [id])
  site        Site         @relation(fields: [siteId], references: [id])
  extractions Extraction[]
  siteActions SiteAction[]

  @@unique([siteId, sha256])
  @@index([orgId])
  @@map("documents")
}

model Extraction {
  id             String    @id @default(uuid()) @db.Uuid
  orgId          String    @map("org_id") @db.Uuid
  documentId     String    @map("document_id") @db.Uuid
  model          String
  fieldsJson     Json      @map("fields_json")
  confidenceJson Json?     @map("confidence_json")
  confirmedBy    String?   @map("confirmed_by") @db.Uuid
  confirmedAt    DateTime? @map("confirmed_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  org      Organisation @relation(fields: [orgId], references: [id])
  document Document     @relation(fields: [documentId], references: [id])

  @@index([orgId])
  @@map("extractions")
}

model EnergyMonth {
  id                String     @id @default(uuid()) @db.Uuid
  orgId             String     @map("org_id") @db.Uuid
  siteId            String     @map("site_id") @db.Uuid
  periodStart       DateTime   @map("period_start") @db.Date
  periodEnd         DateTime   @map("period_end") @db.Date
  kwh               Decimal?   @db.Decimal(14, 2)
  kvah              Decimal?   @db.Decimal(14, 2)
  pf                Decimal?   @db.Decimal(5, 4)
  mdKva             Decimal?   @map("md_kva") @db.Decimal(10, 2)
  peakKwh           Decimal?   @map("peak_kwh") @db.Decimal(14, 2)
  solarHoursKwh     Decimal?   @map("solar_hours_kwh") @db.Decimal(14, 2)
  energyCharges     Decimal?   @map("energy_charges") @db.Decimal(14, 2)
  demandCharges     Decimal?   @map("demand_charges") @db.Decimal(14, 2)
  /// ADDITION: not in Doc 07, needed by HH-1 net-metering bills (kwh = imported kWh; exported kWh here)
  exportKwh         Decimal?   @map("export_kwh") @db.Decimal(14, 2)
  /// ADDITION: not in Doc 07, needed by HH-1 (rooftop solar size in place for this bill, kWp)
  solarInstalledKwp Decimal?   @map("solar_installed_kwp") @db.Decimal(8, 2)
  otherChargesJson  Json?      @map("other_charges_json")
  qualityTag        QualityTag @map("quality_tag")
  createdAt         DateTime   @default(now()) @map("created_at")

  org  Organisation @relation(fields: [orgId], references: [id])
  site Site         @relation(fields: [siteId], references: [id])

  @@unique([siteId, periodStart])
  @@index([orgId])
  @@map("energy_months")
}

model FuelEntry {
  id         String     @id @default(uuid()) @db.Uuid
  orgId      String     @map("org_id") @db.Uuid
  siteId     String     @map("site_id") @db.Uuid
  date       DateTime   @db.Date
  fuelType   String     @map("fuel_type")
  quantity   Decimal    @db.Decimal(14, 3)
  unit       String
  qualityTag QualityTag @map("quality_tag")
  createdAt  DateTime   @default(now()) @map("created_at")

  org  Organisation @relation(fields: [orgId], references: [id])
  site Site         @relation(fields: [siteId], references: [id])

  @@index([orgId])
  @@map("fuel_entries")
}

model ProductionMonth {
  id         String     @id @default(uuid()) @db.Uuid
  orgId      String     @map("org_id") @db.Uuid
  siteId     String     @map("site_id") @db.Uuid
  month      DateTime   @db.Date
  quantity   Decimal    @db.Decimal(14, 3)
  unit       String
  qualityTag QualityTag @map("quality_tag")
  createdAt  DateTime   @default(now()) @map("created_at")

  org  Organisation @relation(fields: [orgId], references: [id])
  site Site         @relation(fields: [siteId], references: [id])

  @@unique([siteId, month])
  @@index([orgId])
  @@map("production_months")
}

model Result {
  id             String   @id @default(uuid()) @db.Uuid
  orgId          String   @map("org_id") @db.Uuid
  siteId         String   @map("site_id") @db.Uuid
  month          DateTime @db.Date
  scope1         Decimal? @db.Decimal(14, 3)
  scope2         Decimal? @db.Decimal(14, 3)
  scope3Metals   Decimal? @map("scope3_metals") @db.Decimal(14, 3)
  intensity      Decimal? @db.Decimal(14, 4)
  factorIds      String[] @map("factor_ids") @db.Uuid
  formulaVersion String   @map("formula_version")
  inputIds       String[] @map("input_ids") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  org  Organisation @relation(fields: [orgId], references: [id])
  site Site         @relation(fields: [siteId], references: [id])

  @@unique([siteId, month])
  @@index([orgId])
  @@map("results")
}

model Baseline {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  siteId    String   @map("site_id") @db.Uuid
  start     DateTime @db.Date
  end       DateTime @db.Date
  a         Decimal  @db.Decimal(18, 6)
  b         Decimal  @db.Decimal(18, 6)
  /// Percent (0-100), not a fraction: 0.4648 means 0.46%. ASHRAE 14 limit is 15.
  cvRmse    Decimal? @map("cv_rmse") @db.Decimal(8, 4)
  /// Percent (0-100). Limit is +/-5.
  nmbe      Decimal? @db.Decimal(8, 4)
  method    String
  createdAt DateTime @default(now()) @map("created_at")

  org  Organisation @relation(fields: [orgId], references: [id])
  site Site         @relation(fields: [siteId], references: [id])

  @@index([orgId])
  @@map("baselines")
}

model SiteAction {
  id              String    @id @default(uuid()) @db.Uuid
  orgId           String    @map("org_id") @db.Uuid
  siteId          String    @map("site_id") @db.Uuid
  actionId        String    @map("action_id") @db.Uuid
  status          String    @default("suggested")
  plannedAt       DateTime? @map("planned_at")
  doneAt          DateTime? @map("done_at")
  actualCost      Decimal?  @map("actual_cost") @db.Decimal(14, 2)
  quoteDocumentId String?   @map("quote_document_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")

  org           Organisation  @relation(fields: [orgId], references: [id])
  site          Site          @relation(fields: [siteId], references: [id])
  action        ActionLibrary @relation(fields: [actionId], references: [id])
  quoteDocument Document?     @relation(fields: [quoteDocumentId], references: [id])

  @@index([orgId])
  @@map("site_actions")
}

model SavingsLedger {
  id        String        @id @default(uuid()) @db.Uuid
  orgId     String        @map("org_id") @db.Uuid
  siteId    String        @map("site_id") @db.Uuid
  month     DateTime      @db.Date
  actionId  String        @map("action_id") @db.Uuid
  kwhSaved  Decimal       @map("kwh_saved") @db.Decimal(14, 2)
  inrSaved  Decimal       @map("inr_saved") @db.Decimal(14, 2)
  co2Saved  Decimal       @map("co2_saved") @db.Decimal(14, 3)
  status    SavingsStatus
  createdAt DateTime      @default(now()) @map("created_at")

  org    Organisation  @relation(fields: [orgId], references: [id])
  site   Site          @relation(fields: [siteId], references: [id])
  action ActionLibrary @relation(fields: [actionId], references: [id])

  @@index([orgId])
  @@map("savings_ledger")
}

/// Frozen, read-only input to a report (Doc 05 generation step 2). Never edited.
model ReportSnapshot {
  id               String   @id @default(uuid()) @db.Uuid
  orgId            String   @map("org_id") @db.Uuid
  siteId           String   @map("site_id") @db.Uuid
  type             String
  language         String
  /// ADDITION: not in Doc 07, needed to number loan-pack versions per action (Doc 05 Regeneration)
  actionCode       String?  @map("action_code")
  inputsJson       Json     @map("inputs_json")
  resultsJson      Json     @map("results_json")
  factorIds        String[] @map("factor_ids") @db.Uuid
  formulaVersion   String   @map("formula_version")
  dataQualityScore Decimal? @map("data_quality_score") @db.Decimal(6, 2)
  createdAt        DateTime @default(now()) @map("created_at")

  org     Organisation @relation(fields: [orgId], references: [id])
  site    Site         @relation(fields: [siteId], references: [id])
  reports Report[]

  @@index([orgId])
  @@index([siteId, type, actionCode])
  @@map("report_snapshots")
}

model Report {
  id         String   @id @default(uuid()) @db.Uuid
  orgId      String   @map("org_id") @db.Uuid
  snapshotId String   @unique @map("snapshot_id") @db.Uuid
  type       String
  language   String
  fileKey    String   @map("file_key")
  sha256     String
  /// ADDITION: not in Doc 07, needed by Doc 05 Regeneration (new snapshot = version n+1)
  version    Int
  createdAt  DateTime @default(now()) @map("created_at")

  org      Organisation   @relation(fields: [orgId], references: [id])
  snapshot ReportSnapshot @relation(fields: [snapshotId], references: [id])
  shares   Share[]

  @@index([orgId])
  @@map("reports")
}

model Share {
  id        String    @id @default(uuid()) @db.Uuid
  orgId     String    @map("org_id") @db.Uuid
  reportId  String    @map("report_id") @db.Uuid
  recipient String
  /// ADDITION: not in Doc 07; sha256 of the share token (the raw token is never stored)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  /// ADDITION: not in Doc 07, needed to revoke a share link before it expires
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  org    Organisation @relation(fields: [orgId], references: [id])
  report Report       @relation(fields: [reportId], references: [id])
  views  ShareView[]

  @@index([orgId])
  @@index([reportId])
  @@map("shares")
}

/// Every view and download of a shared report (Doc 05 generation step 7).
model ShareView {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  shareId   String   @map("share_id") @db.Uuid
  kind      String
  at        DateTime @default(now())
  userAgent String?  @map("user_agent")

  org   Organisation @relation(fields: [orgId], references: [id])
  share Share        @relation(fields: [shareId], references: [id])

  @@index([orgId])
  @@index([shareId])
  @@map("share_views")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  actor     String
  action    String
  target    String?
  at        DateTime @default(now())
  createdAt DateTime @default(now()) @map("created_at")

  org Organisation @relation(fields: [orgId], references: [id])

  @@index([orgId])
  @@map("audit_log")
}

/// ADDITION: not in Doc 07, needed by VER-2 (non-routine adjustments to verified savings)
model NonRoutineAdjustment {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  siteId    String   @map("site_id") @db.Uuid
  month     DateTime @db.Date
  kwhEffect Decimal  @map("kwh_effect") @db.Decimal(14, 2)
  reason    String
  loggedBy  String   @map("logged_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  org    Organisation @relation(fields: [orgId], references: [id])
  site   Site         @relation(fields: [siteId], references: [id])
  logger User         @relation(fields: [loggedBy], references: [id])

  @@index([orgId])
  @@map("non_routine_adjustments")
}

/// ADDITION: not in Doc 07, needed by the s_enduse term in Doc 03 action savings
model SiteEquipment {
  id          String     @id @default(uuid()) @db.Uuid
  orgId       String     @map("org_id") @db.Uuid
  siteId      String     @map("site_id") @db.Uuid
  equipment   String
  enduseShare Decimal    @map("enduse_share") @db.Decimal(5, 4)
  qualityTag  QualityTag @map("quality_tag")
  createdAt   DateTime   @default(now()) @map("created_at")

  org  Organisation @relation(fields: [orgId], references: [id])
  site Site         @relation(fields: [siteId], references: [id])

  @@index([orgId])
  @@map("site_equipment")
}

// ---------------------------------------------------------------- reference tables (no org_id)

model Factor {
  id           String       @id @default(uuid()) @db.Uuid
  sourceType   String       @map("source_type")
  value        Decimal      @db.Decimal(18, 6)
  unit         String
  source       String
  sourceUrl    String?      @map("source_url")
  version      String?
  /// ADDITION: not in Doc 07, needed by Doc 03 Emission factor table (nullable valid_from)
  validFrom    DateTime?    @map("valid_from") @db.Date
  /// ADDITION: not in Doc 07, last day a per-FY factor applies (CEA publishes one value per FY)
  validTo      DateTime?    @map("valid_to") @db.Date
  supersededBy String?      @map("superseded_by") @db.Uuid
  /// ADDITION: not in Doc 07, page in the source and the quoted line the value comes from
  page         String?
  quotedLine   String?      @map("quoted_line")
  /// ADDITION: not in Doc 07, needed by Doc 03 Emission factor table "Status" column
  status       FactorStatus
  /// ADDITION: not in Doc 07, needed by the Doc 03 note that grid is CO2-only and fuels are CO2e
  gasBasis     GasBasis?    @map("gas_basis")
  /// ADDITION: not in Doc 07, needed by Doc 03 Emission factor table "Basis" column
  basisNote    String?      @map("basis_note")
  createdAt    DateTime     @default(now()) @map("created_at")

  @@index([sourceType, version])
  @@map("factors")
}

model TariffRule {
  id         String    @id @default(uuid()) @db.Uuid
  discom     String
  category   String
  ruleType   String    @map("rule_type")
  paramsJson Json      @map("params_json")
  validFrom  DateTime? @map("valid_from") @db.Date
  /// ADDITION: not in Doc 07, needed by Doc 03 Bill health check (source and "inferred from FY" note)
  source     String
  basisNote  String?   @map("basis_note")
  status     String?
  /// ADDITION: not in Doc 07, tariff order the row comes from ("legacy" = pre-research rows), so
  /// rules from different orders coexist; the one valid for the bill period is used
  version    String    @default("legacy")
  /// ADDITION: not in Doc 07, source link, printed page and quoted line of the tariff order
  sourceUrl  String?   @map("source_url")
  page       String?
  quotedLine String?   @map("quoted_line")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@unique([discom, category, ruleType, version])
  @@map("tariff_rules")
}

model ActionLibrary {
  id              String   @id @default(uuid()) @db.Uuid
  /// ADDITION: not in Doc 07, needed by seed/runtime lookup of bill-health actions
  code            String   @unique
  sector          String
  equipment       String
  savingLow       Decimal? @map("saving_low") @db.Decimal(14, 2)
  savingHigh      Decimal? @map("saving_high") @db.Decimal(14, 2)
  costLow         Decimal? @map("cost_low") @db.Decimal(14, 2)
  costHigh        Decimal? @map("cost_high") @db.Decimal(14, 2)
  sourceUrl       String?  @map("source_url")
  /// ADDITION: not in Doc 07, needed by Doc 03 action savings (zero-cost vs capex, end-use, provenance)
  isZeroCost      Boolean  @map("is_zero_cost")
  enduse          Enduse
  status          String
  source          String
  /// ADDITION: not in Doc 07, provenance and saving basis for sourced measures (research R2)
  page            String?
  quotedLine      String?  @map("quoted_line")
  costYear        String?  @map("cost_year")
  costNote        String?  @map("cost_note")
  /// ADDITION: saving_low/high above are % of the end-use's kWh; end-use share of site kWh (0-1)
  enduseShareLow  Decimal? @map("enduse_share_low") @db.Decimal(5, 4)
  enduseShareHigh Decimal? @map("enduse_share_high") @db.Decimal(5, 4)
  enduseShareNote String?  @map("enduse_share_note")
  savingNote      String?  @map("saving_note")
  createdAt       DateTime @default(now()) @map("created_at")

  siteActions SiteAction[]
  ledger      SavingsLedger[]

  @@map("action_library")
}

model Scheme {
  id            String    @id @default(uuid()) @db.Uuid
  /// ADDITION: not in Doc 07, natural key for sourced R8 rows (legacy rows have none)
  code          String?   @unique
  name          String    @unique
  rulesJson     Json      @map("rules_json")
  rateRange     String?   @map("rate_range")
  lastCheckedAt DateTime? @map("last_checked_at")
  /// ADDITION: not in Doc 07, needed by ADM-1 / Schemes (ended schemes, source, status)
  active        Boolean
  statusNote    String?   @map("status_note")
  source        String
  /// ADDITION: not in Doc 07, needed by FIN-1 (link to the scheme's source and the quoted line)
  sourceUrl     String?   @map("source_url")
  quotedLine    String?   @map("quoted_line")
  /// ADDITION: not in Doc 07, plain-language benefit shown on /schemes
  benefitText   String?   @map("benefit_text")
  /// ADDITION: not in Doc 07, display order on /schemes
  sortOrder     Int       @default(100) @map("sort_order")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@map("schemes")
}

/// ADDITION: not in Doc 07, needed by Doc 03 Benchmarks (sector intensity ranges)
model Benchmark {
  id        String   @id @default(uuid()) @db.Uuid
  sector    String
  metric    String
  low       Decimal  @db.Decimal(14, 3)
  high      Decimal  @db.Decimal(14, 3)
  unit      String
  source    String
  status    String
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([sector, metric])
  @@map("benchmarks")
}

/// ADDITION: not in Doc 07, needed by REP-2 (EU CN codes for the CBAM supplier sheet, R4)
model CbamCnCode {
  id                String    @id @default(uuid()) @db.Uuid
  code              String    @unique
  description       String
  inScopeNow        Boolean   @map("in_scope_now")
  proposedFrom      DateTime? @map("proposed_from") @db.Date
  /// EU default for India, total column (t CO2e per t of good); null when the source gives none
  indiaDefaultTotal Decimal?  @map("india_default_total") @db.Decimal(10, 3)
  source            String
  sourceUrl         String?   @map("source_url")
  createdAt         DateTime  @default(now()) @map("created_at")

  @@map("cbam_cn_codes")
}

/// ADDITION: not in Doc 07, needed by REP-2 (mark-up on EU default values by year, R4)
model CbamMarkup {
  id         String   @id @default(uuid()) @db.Uuid
  yearFrom   Int      @unique @map("year_from")
  pct        Decimal  @db.Decimal(5, 2)
  source     String
  sourceUrl  String?  @map("source_url")
  quotedLine String?  @map("quoted_line")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("cbam_markups")
}

/// ADDITION: not in Doc 07, D7 Mitra: free NGO and government help (findings-round2.md "Free help listed in Mitra")
model MitraItem {
  id               String   @id @default(uuid()) @db.Uuid
  code             String   @unique
  /// "ngo" | "govt" | "both"
  page             String
  title            String
  runBy            String   @map("run_by")
  freeHelp         String   @map("free_help")
  businessGain     String   @map("business_gain")
  carbonLine       String?  @map("carbon_line")
  howToStart       String   @map("how_to_start")
  url              String?
  contactEmail     String?  @map("contact_email")
  contactPhone     String?  @map("contact_phone")
  address          String?
  /// "handoff" | "link" | "commitment" | "visit" | "learn"
  kind             String
  sourceUrl        String   @map("source_url")
  quotedLine       String   @map("quoted_line")
  lastChecked      DateTime @map("last_checked") @db.Date
  /// Findings say UNCONFIRMED for current dates: show "check current dates", never a date
  datesUnconfirmed Boolean  @default(false) @map("dates_unconfirmed")
  sortOrder        Int      @default(100) @map("sort_order")
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("mitra_items")
}

/// ADDITION: not in Doc 07, D7 Mitra: one owner's progress on one free step (org-scoped, never seeded)
model MitraStep {
  id                  String    @id @default(uuid()) @db.Uuid
  orgId               String    @map("org_id") @db.Uuid
  siteId              String    @map("site_id") @db.Uuid
  itemCode            String    @map("item_code")
  /// "not_started" | "started" | "done_self" | "confirmed"
  status              String
  proofFileKey        String?   @map("proof_file_key")
  proofSha256         String?   @map("proof_sha256")
  proofType           String?   @map("proof_type")
  proofNote           String?   @map("proof_note")
  eventDate           DateTime? @map("event_date") @db.Date
  packReportId        String?   @map("pack_report_id") @db.Uuid
  certificateReportId String?   @map("certificate_report_id") @db.Uuid
  startedAt           DateTime? @map("started_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  org  Organisation @relation(fields: [orgId], references: [id])
  site Site         @relation(fields: [siteId], references: [id])

  @@unique([orgId, siteId, itemCode])
  @@index([orgId])
  @@map("mitra_steps")
}

/// ADDITION: not in Doc 07, D7 Mitra: published case studies ("A foundry that did this")
model PeerCase {
  id              String   @id @default(uuid()) @db.Uuid
  code            String   @unique
  company         String
  place           String
  actionCode      String?  @map("action_code")
  measure         String
  investmentText  String   @map("investment_text")
  savingText      String?  @map("saving_text")
  paybackText     String   @map("payback_text")
  beforeAfterText String?  @map("before_after_text")
  source          String
  sourceUrl       String   @map("source_url")
  page            String?
  quotedLine      String   @map("quoted_line")
  sortOrder       Int      @default(100) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("peer_cases")
}
