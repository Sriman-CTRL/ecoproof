{
  "name": "@ecoproof/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "prisma generate && tsc -p tsconfig.json",
    "test": "echo \"no tests in @ecoproof/api yet\"",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:demo": "tsx prisma/demo/seed-demo.ts",
    "db:demo:reset": "tsx prisma/demo/seed-demo.ts --reset",
    "bills:render": "tsx prisma/demo/bills/render-bills.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@ecoproof/calc": "workspace:*",
    "@ecoproof/shared": "workspace:*",
    "@prisma/client": "^6.19.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "playwright": "^1.64.0",
    "prisma": "^6.19.0",
    "tsx": "^4.20.0"
  }
}
